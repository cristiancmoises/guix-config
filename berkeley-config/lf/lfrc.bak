# --- Preview ---
set previewer ~/.local/bin/lf/preview
set preview true
set ratios 2:5     # Left = 2, Right = 5 (preview)
set drawbox true

# --- Columns ---
set column 2       # duas colunas: arquivos + preview

# --- Sorting ---
set sortby time
set reverse true

# --- IFS ---
set ifs "\n"

# --- Quit ---
cmd q :quit

# --- Copy filename ---
cmd copy_filename ${{ 
    clean_filename=$(basename "$f")
    printf "%s" "${clean_filename%.*}" | xclip -selection clipboard
}}
map <c-e> :copy_filename <ret>

# --- Open files ---
cmd open ${{ 
    case "$f" in
        *.jpg|*.jpeg|*.png|*.gif|*.bmp|*.webp)
            feh --auto-zoom --scale-down --fullscreen --draw-filename --filename-bg black --filename-color yellow "$f" ;;
        *.mp4|*.mkv|*.webm|*.avi|*.mov)
            mpv "$f" ;;
        *)
            xdg-open "$f" ;;
    esac
}}
map <c-o> :open <ret>

# --- Abrir arquivos diretamente ---
cmd open ${{ 
    case "$f" in
        *.jpg|*.jpeg|*.png|*.gif|*.bmp|*.webp|*.svg)
            # Abre toda a pasta com Feh em fullscreen, zoom automático e nome do arquivo
            feh --fullscreen \
                --auto-zoom \
                --draw-filename \
                --reload 1 \
                --sort filename \
                --action1 "echo next" \
                --action2 "echo prev" \
                "$(dirname "$f")"
            ;;
        *.mp4|*.mkv) 
            mpv "$f"
            ;;
        *) 
            xdg-open "$f"
            ;;
    esac
}}
